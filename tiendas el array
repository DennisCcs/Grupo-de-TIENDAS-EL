    public static void agregarProductoAdmin() {
        System.out.println("--- AÑADIR PRODUCTO ---");
        System.out.println("¿En qué categoría?");
        System.out.println("1-Formal | 2-Casual | 3-Ropa Interior | 4-Accesorios");
        System.out.print("Opción: ");
        int cat = sc.nextInt();
        sc.nextLine();

        System.out.print("Nombre del producto: ");
        String nombre = sc.nextLine();
        System.out.print("Precio S/: ");
        double precio = sc.nextDouble();
        sc.nextLine();

        switch(cat){
            case 1: productosFormal.add(nombre); preciosFormal.add(precio); break;
            case 2: productosCasual.add(nombre); preciosCasual.add(precio); break;
            case 3: productosRopaInterior.add(nombre); preciosRopaInterior.add(precio); break;
            case 4: productosAccesorios.add(nombre); preciosAccesorios.add(precio); break;
            default: System.out.println("❌ Categoría inválida"); return;
        }
        System.out.println("✅ PRODUCTO AGREGADO CORRECTAMENTE");
        // Actualizar promoción
        Random rand = new Random();
        categoriaPromocion = rand.nextInt(4);
        switch(categoriaPromocion){
            case 0: indicePromocion = rand.nextInt(productosFormal.size()); break;
            case 1: indicePromocion = rand.nextInt(productosCasual.size()); break;
            case 2: indicePromocion = rand.nextInt(productosRopaInterior.size()); break;
            case 3: indicePromocion = rand.nextInt(productosAccesorios.size()); break;
        }
    }
    public static void eliminarProductoAdmin() {
        System.out.println("--- ELIMINAR PRODUCTO ---");
        System.out.println("¿En qué categoría?");
        System.out.println("1-Formal | 2-Casual | 3-Ropa Interior | 4-Accesorios");
        System.out.print("Opción: ");
        int cat = sc.nextInt();
        sc.nextLine();

        ArrayList<String> lista = null;
        ArrayList<Double> listaP = null;

        switch(cat){
            case 1: lista = productosFormal; listaP = preciosFormal; break;
            case 2: lista = productosCasual; listaP = preciosCasual; break;
            case 3: lista = productosRopaInterior; listaP = preciosRopaInterior; break;
            case 4: lista = productosAccesorios; listaP = preciosAccesorios; break;
            default: System.out.println("❌ Categoría inválida"); return;
        }

        for (int i = 0; i < lista.size(); i++)
            System.out.printf("[%d] %s - S/ %.2f%n", i, lista.get(i), listaP.get(i));
        System.out.print("Ingrese el índice a eliminar: ");
        int pos = sc.nextInt();
        sc.nextLine();

        if (pos >= 0 && pos < lista.size()) {
            lista.remove(pos);
            listaP.remove(pos);
            System.out.println("✅ PRODUCTO ELIMINADO");
            // Si eliminamos el de promoción, generar nuevo
            if ((cat-1) == categoriaPromocion && pos == indicePromocion) {
                Random rand = new Random();
                categoriaPromocion = rand.nextInt(4);
                switch(categoriaPromocion){
                    case 0: indicePromocion = rand.nextInt(productosFormal.size()); break;
                    case 1: indicePromocion = rand.nextInt(productosCasual.size()); break;
                    case 2: indicePromocion = rand.nextInt(productosRopaInterior.size()); break;
                    case 3: indicePromocion = rand.nextInt(productosAccesorios.size()); break;
                }
            }
        } else {
            System.out.println("❌ Índice inválido");
        }
    }
