            System.out.println("✅ PRODUCTO ELIMINADO");
            if (pos == indicePromocion) {
                Random rand = new Random();
                indicePromocion = rand.nextInt(productos.size());
            }
        } else {
            System.out.println("❌ Índice inválido");
        }
    }
}
