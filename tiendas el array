    public static void agregarAlCarrito(int indice) {
        double precioUnitario = precioPRODUCTOS.get(indice);
        // Aplicar descuento si es promoción
        if (indice == indicePromocion) {
            precioUnitario = precioUnitario - (precioUnitario * descuentoPromo / 100);
        }

        System.out.println("Producto: " + productos.get(indice));
        System.out.println("Precio a pagar: S/ " + precioUnitario);

        // Elegir talla
        System.out.println("Elija talla:");
        for (int i = 0; i < tallasDISPONIBLES.size(); i++)
            System.out.println((i + 1) + ". " + tallasDISPONIBLES.get(i));
        int tallaOpc = sc.nextInt();
        sc.nextLine();
        String tallaElegida = (tallaOpc >= 1 && tallaOpc <= tallasDISPONIBLES.size()) ? tallasDISPONIBLES.get(tallaOpc - 1) : "Única";

        // Elegir cantidad
        System.out.println("Cantidad:");
        int cant = sc.nextInt();
        sc.nextLine();

        // Guardar
        carritoNombres.add(productos.get(indice));
        carritoPrecios.add(precioUnitario);
        carritoCantidad.add(cant);
        carritoTallas.add(tallaElegida);
        System.out.println("✅ Agregado al carrito correctamente\n");
    }
