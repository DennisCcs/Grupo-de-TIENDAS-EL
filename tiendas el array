    public static void mostrarProductos(ArrayList<String> listaProd, ArrayList<Double> listaPrec, int catActual) {
        System.out.println("--- PRODUCTOS ---");
        for (int i = 0; i < listaProd.size(); i++) {
            double precioFinal = listaPrec.get(i);
            if (catActual == categoriaPromocion && i == indicePromocion) {
                double precioDesc = precioFinal - (precioFinal * descuentoPromo / 100);
                System.out.printf("%d. %s - S/ %.2f 🔥 PROMOCIÓN: S/ %.2f (%d%% dscto)%n",
                        (i+1), listaProd.get(i), precioFinal, precioDesc, (int)descuentoPromo);

                //%d → Aquí va un número entero (ej: posición, porcentaje).
                //%s → Aquí va un texto (ej: nombre del producto).
                //%.2f → Aquí va un número decimal, y lo obliga a mostrar siempre 2 decimales (ej: 599.90).
                //%n → Es un salto de línea.

            } else {
                System.out.printf("%d. %s - S/ %.2f%n", (i+1), listaProd.get(i), precioFinal);
            }
        }
        System.out.println("0. Volver");
        System.out.print("Elija producto: ");
        int opc = sc.nextInt();
        sc.nextLine();

        if (opc == 0) return;
        int indiceReal = opc - 1;

        if (indiceReal >= 0 && indiceReal < listaProd.size()) {
            agregarAlCarrito(listaProd, listaPrec, indiceReal, catActual);
        } else {
            System.out.println("Opción incorrecta");
        }
    }
    public static void agregarAlCarrito(ArrayList<String> listaProd, ArrayList<Double> listaPrec, int indice, int catActual) {
        double precioUnitario = listaPrec.get(indice);
        if (catActual == categoriaPromocion && indice == indicePromocion) {
            precioUnitario = precioUnitario - (precioUnitario * descuentoPromo / 100);
        }

        System.out.println("Producto: " + listaProd.get(indice));
        System.out.printf("Precio a pagar: S/ %.2f%n", precioUnitario);

        String tallaElegida;
        if (catActual == 3) {
            tallaElegida = "Sin talla";
            System.out.println("✅ Producto sin talla disponible");
        } else {
            System.out.println("Elija talla:");
            for (int i = 0; i < tallasDISPONIBLES.size(); i++)
                System.out.println((i + 1) + ". " + tallasDISPONIBLES.get(i));
            System.out.print("Opción: ");
            int tallaOpc = sc.nextInt();
            sc.nextLine();
            tallaElegida = (tallaOpc >= 1 && tallaOpc <= tallasDISPONIBLES.size()) ? tallasDISPONIBLES.get(tallaOpc - 1) : "Única";
        }

        System.out.print("Cantidad: ");
        int cant = sc.nextInt();
        sc.nextLine();

        carritoNombres.add(listaProd.get(indice));
        carritoPrecios.add(precioUnitario);
        carritoCantidad.add(cant);
        carritoTallas.add(tallaElegida);
        System.out.println("✅ Agregado al carrito correctamente\n");
    }
