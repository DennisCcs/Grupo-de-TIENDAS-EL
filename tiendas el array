    public static void mostrarProductos(int inicio, int fin) {
        System.out.println("--- PRODUCTOS ---");
        for (int i = inicio; i < fin; i++) {
            if (i < productos.size()) {
                double precioFinal = precioPRODUCTOS.get(i);
                if (i == indicePromocion) {
                    double precioDesc = precioFinal - (precioFinal * descuentoPromo / 100);
                    System.out.printf("%d. %s - S/ %.2f 🔥 PROMOCIÓN: S/ %.2f (%d%% dscto)%n",
                            (i - inicio + 1), productos.get(i), precioFinal, precioDesc, (int)descuentoPromo);
                } else {
                    System.out.println((i - inicio + 1) + ". " + productos.get(i) + " - S/ " + precioFinal);
                }
            }
        }
        System.out.println("0. Volver");
        System.out.print("Elija producto: ");
        int opc = sc.nextInt();
        sc.nextLine();

        if (opc == 0) return;
        int indiceReal = inicio + (opc - 1);

        if (indiceReal >= inicio && indiceReal < fin) {
            agregarAlCarrito(indiceReal);
        } else {
            System.out.println("Opción incorrecta");
        }
    }
    public static void buscarProducto(){
        System.out.println("🔍 BUSCAR PRODUCTO");
        System.out.print("Ingrese nombre o parte del nombre: ");
        String busqueda = sc.nextLine().toLowerCase();
        boolean encontrado = false;

        for (int i = 0; i < productos.size(); i++) {
            if (productos.get(i).toLowerCase().contains(busqueda)) {
                double precio = precioPRODUCTOS.get(i);
                if (i == indicePromocion) {
                    double precioDesc = precio - (precio * descuentoPromo / 100);
                    System.out.printf("✅ %s - S/ %.2f | 🔥 PROMO: S/ %.2f%n", productos.get(i), precio, precioDesc);
                } else {
                    System.out.printf("✅ %s - S/ %.2f%n", productos.get(i), precio);
                }
                encontrado = true;
            }
        }
        if (!encontrado) System.out.println("❌ Ningún producto coincide con su búsqueda.");
    }
    public static void filtrarPorPrecio() {
        System.out.println("💰 FILTRAR POR RANGO DE PRECIO");
        System.out.print("Precio mínimo S/: ");
        double min = sc.nextDouble();
        System.out.print("Precio máximo S/: ");
        double max = sc.nextDouble();
        sc.nextLine();
        boolean encontrado = false;

        System.out.println("--- RESULTADOS ---");
        for (int i = 0; i < productos.size(); i++) {
            double precio = precioPRODUCTOS.get(i);
            if (precio >= min && precio <= max) {
                if (i == indicePromocion) {
                    double precioDesc = precio - (precio * descuentoPromo / 100);
                    System.out.printf("%s - S/ %.2f 🔥 PROMO: S/ %.2f%n", productos.get(i), precio, precioDesc);
                } else {
                    System.out.printf("%s - S/ %.2f%n", productos.get(i), precio);
                }
                encontrado = true;
            }
        }
        if (!encontrado) System.out.println("❌ No hay productos en ese rango.");
    }
