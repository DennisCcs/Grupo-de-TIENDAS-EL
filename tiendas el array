    public static boolean filtrarLista(ArrayList<String> prod, ArrayList<Double> prec, int cat, double min, double max){
        boolean ok = false;
        for (int i = 0; i < prod.size(); i++) {
            double precio = prec.get(i);
            if (precio >= min && precio <= max) {
                if (cat == categoriaPromocion && i == indicePromocion) {
                    double precioDesc = precio - (precio * descuentoPromo / 100);
                    System.out.printf("%s - S/ %.2f 🔥 PROMO: S/ %.2f%n", prod.get(i), precio, precioDesc);
                } else {
                    System.out.printf("%s - S/ %.2f%n", prod.get(i), precio);
                }
                ok = true;
            }
        }
        return ok;
    }
